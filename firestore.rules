rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Product catalogue: public read/write so the existing custom admin page works without Firebase Authentication.
    // WARNING: anyone who knows the project can modify these documents. For stronger security, add Firebase Auth later.
    match /products/{productId} { allow read, write: if true; }
    match /orders/{orderId} { allow read, write: if true; }
    match /coupons/{couponId} { allow read, write: if true; }
    match /customers/{customerId} { allow read, write: if true; }

    // Keep your existing rules for other collections unchanged.
    match /attendance/{docId} { allow read, write: if true; }
  }
}
